{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheGameratorT/NCPatcher/main/schema/module.schema.json",
  "title": "NCPatcher module",
  "description": "Schema for a module.yaml consumed by NCPatcher's module resolver.",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "description": "Stable module identifier used by MODULE_<ID> defines and cross-module requirements.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "$ref": "#/$defs/stringList"
    },
    "repo": {
      "type": "string"
    },
    "defines": {
      "$ref": "#/$defs/defines"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "nitrofs": {
      "description": "A directory this module sweeps into NitroFS, so its assets are declared once rather than listed file by file. Two rules settle a path two modules both provide: a file chosen for the built variant beats one that applies to every variant, and within one layer the module listed first in the project's `modules.enabled` keeps the path. A directory whose name ends in `_narc` means the Nitro archive beside it, and everything below it is a path inside that archive: `ARCHIVE/menu_title_narc/menu/title/USA/vs.bmg` replaces that member of `ARCHIVE/menu_title.narc`.",
      "type": "object",
      "required": [
        "dir"
      ],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "description": "The source directory, relative to this module.",
          "type": "string",
          "minLength": 1
        },
        "layered": {
          "description": "Read the first path segment under `dir` as a variant name rather than part of the ROM path. A variant this module has no directory for contributes nothing, which is how a module ships assets for some languages and not others.",
          "type": "boolean",
          "default": false
        },
        "base-variant": {
          "description": "A layer applied underneath the built variant. Requires `layered`.",
          "type": "string",
          "minLength": 1
        },
        "into": {
          "description": "A ROM path prefix for everything the tree produces.",
          "type": "string"
        }
      }
    },
    "components": {
      "$ref": "#/$defs/components"
    }
  },
  "$defs": {
    "stringList": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "defines": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringList"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      ]
    },
    "targetRef": {
      "type": "string",
      "pattern": "^!?arm[79](\\([0-9]+\\))?$"
    },
    "targetBody": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/targetBodyMap"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "includes": {
                "$ref": "#/$defs/stringList"
              },
              "sources": {
                "$ref": "#/$defs/stringList"
              }
            }
          }
        }
      ]
    },
    "targetBodyMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes": {
          "$ref": "#/$defs/stringList"
        },
        "sources": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "targetEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/targetRef"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/targetRef"
          },
          "additionalProperties": {
            "$ref": "#/$defs/targetBody"
          }
        }
      ]
    },
    "targets": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/targetRef"
          },
          "additionalProperties": {
            "$ref": "#/$defs/targetBody"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetEntry"
          }
        }
      ]
    },
    "componentBody": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "$ref": "#/$defs/targetRef"
            },
            "sources": {
              "$ref": "#/$defs/stringList"
            },
            "includes": {
              "$ref": "#/$defs/stringList"
            },
            "defines": {
              "$ref": "#/$defs/defines"
            },
            "files": {
              "description": "Glob patterns naming the ROM destinations this component owns, matched against the NitroFS path with any variant segment already stripped. While the component is enabled they only record ownership; when it is disabled they subtract those files from this module's `nitrofs` tree, so switching a feature off removes its assets along with its code.",
              "$ref": "#/$defs/stringList"
            },
            "requires": {
              "$ref": "#/$defs/stringList"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "componentEntry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/componentBody"
          }
        }
      ]
    },
    "components": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/componentBody"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentEntry"
          }
        }
      ]
    }
  }
}
