# Script-mode CMake (invoked by the `installer` target): run makensis on the
# NSIS script with every path/version passed in as a /D define. Nothing is
# written back into the source tree; the Setup exe lands in the build dir.
#
# Required -D variables: BINARY_DIR, SOURCE_DIR, STAGE_DIR, APP_VERSION.

cmake_minimum_required(VERSION 3.20)

foreach(var BINARY_DIR SOURCE_DIR STAGE_DIR APP_VERSION)
	if (NOT ${var})
		message(FATAL_ERROR "${var} must be set when running this script")
	endif()
endforeach()

# Prefer the official NSIS installer's makensis over MSYS2's NSIS package. The
# MSYS2 package ships its plugins under share/nsis/Plugins/unicode, a layout
# makensis 3.13 does not search, so the MUI2 pages die with "Plugin not found,
# cannot call nsDialogs::Create". Fall back to PATH, so a makensis that works
# elsewhere is still picked up. The default install locations are listed
# literally because MSYS2's bash drops the ProgramFiles(x86) variable.
find_program(MAKENSIS_EXECUTABLE
	NAMES makensis makensis.exe
	HINTS
		"C:/Program Files (x86)/NSIS"
		"C:/Program Files/NSIS"
	DOC "NSIS makensis compiler")
if (NOT MAKENSIS_EXECUTABLE)
	message(FATAL_ERROR "makensis not found. Install NSIS from "
		"https://nsis.sourceforge.io/ (or `choco install nsis`) so that "
		"makensis is on PATH or in the default install directory.")
endif()

if (NOT EXISTS "${STAGE_DIR}/ncpatcher.exe")
	message(FATAL_ERROR "${STAGE_DIR} holds no ncpatcher.exe; the install step did not run")
endif()

# The uninstaller removes exactly what was staged, so it is generated from the
# stage rather than kept by hand next to the install rules, where it would fall
# behind the first time a file was added. Directories go deepest first, so each
# is empty by the time its RMDir runs.
file(GLOB_RECURSE _files RELATIVE "${STAGE_DIR}" "${STAGE_DIR}/*")
file(GLOB_RECURSE _dirs LIST_DIRECTORIES true RELATIVE "${STAGE_DIR}" "${STAGE_DIR}/*")
list(REMOVE_ITEM _dirs ${_files})
list(SORT _dirs ORDER DESCENDING)

set(UNINSTALL_LIST "${BINARY_DIR}/installer_uninstall.nsh")
set(_lines "; Generated by build_installer.cmake from ${STAGE_DIR}.\n")
foreach(_file ${_files})
	string(REPLACE "/" "\\" _native "${_file}")
	string(APPEND _lines "Delete \"$INSTDIR\\${_native}\"\n")
endforeach()
foreach(_dir ${_dirs})
	string(REPLACE "/" "\\" _native "${_dir}")
	string(APPEND _lines "RMDir \"$INSTDIR\\${_native}\"\n")
endforeach()
file(WRITE "${UNINSTALL_LIST}" "${_lines}")

set(OUTPUT "${BINARY_DIR}/ncpatcher-${APP_VERSION}-setup.exe")

# VIProductVersion needs four fields; pad x.y.z out to x.y.z.0.
set(VIVERSION "${APP_VERSION}.0")

# makensis on Windows wants native (backslash) paths in its /D defines.
file(TO_NATIVE_PATH "${STAGE_DIR}" STAGE_DIR_NATIVE)
file(TO_NATIVE_PATH "${UNINSTALL_LIST}" UNINSTALL_LIST_NATIVE)
file(TO_NATIVE_PATH "${SOURCE_DIR}/LICENSE.txt" LICENSE_NATIVE)
file(TO_NATIVE_PATH "${SOURCE_DIR}/icon.ico" ICON_NATIVE)
file(TO_NATIVE_PATH "${OUTPUT}" OUTPUT_NATIVE)

message(STATUS "Creating installer ${OUTPUT}")
execute_process(
	COMMAND "${MAKENSIS_EXECUTABLE}"
		"/DVERSION=${APP_VERSION}"
		"/DVIVERSION=${VIVERSION}"
		"/DSTAGE_DIR=${STAGE_DIR_NATIVE}"
		"/DUNINSTALL_LIST=${UNINSTALL_LIST_NATIVE}"
		"/DLICENSE_FILE=${LICENSE_NATIVE}"
		"/DICON=${ICON_NATIVE}"
		"/DOUTFILE=${OUTPUT_NATIVE}"
		"${SOURCE_DIR}/installer/ncpatcher.nsi"
	RESULT_VARIABLE INSTALLER_RESULT)
if (NOT INSTALLER_RESULT EQUAL 0)
	message(FATAL_ERROR "makensis failed with exit code ${INSTALLER_RESULT}")
endif()
message(STATUS "Installer created: ${OUTPUT}")
